# ============================================
# Mnemosyne — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- CockroachDB ---
# Get this from CockroachDB Cloud Console → Connect → Connection String
# Format: postgresql://username:password@host:26257/defaultdb?sslmode=verify-full
COCKROACHDB_URL=postgresql://your_user:your_password@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# --- AWS ---
# Your AWS region (must have Bedrock model access enabled)
AWS_REGION=us-east-1

# AWS credentials (or use AWS CLI profile / IAM role)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# --- Bedrock Model IDs ---
# These are the default model IDs; change only if using different models
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-20250514
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- S3 (Phase 3) ---
S3_BUCKET_NAME=mnemosyne-documents

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
